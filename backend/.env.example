# CareerCompass Environment Configuration
PROJECT_NAME=CareerCompass
API_V1_STR=/api/v1
SECRET_KEY=careercompass_super_secret_production_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL default, falls back to SQLite if unreachable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careercompass_db
SQLITE_FALLBACK_URL=sqlite:///./careercompass.db

# Redis Configuration (Optional, falls back to in-memory cache)
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration (supports Gemini, OpenAI, Claude, or Built-in Offline Engine)
AI_PROVIDER=builtin
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=gemini-1.5-pro

# S3 / Object Storage (Optional for PDF attachments)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=careercompass-docs

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
